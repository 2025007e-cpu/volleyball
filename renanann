function insertEmojiToInput(textOrCode) {
    const input = document.getElementById("messageInput");
    if(!input) return;

    const start = input.selectionStart;
    const end = input.selectionEnd;

    if (typeof start === 'number' && typeof end === 'number') {
        input.value = input.value.substring(0, start) + textOrCode + input.value.substring(end);
        input.selectionStart = input.selectionEnd = start + textOrCode.length;
    } else {
        input.value += textOrCode;
    }
    input.focus();
}

