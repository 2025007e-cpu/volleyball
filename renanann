async function sellStamp() {
    const type = document.getElementById("stType").value;
    const name = document.getElementById("stName").value.trim();
    const price = Number(document.getElementById("stPrice").value);
    const fileInput = document.getElementById("stImg");

    if(!name) return alert("アイテム名（または絵文字）を入力してください");

    let img = null;
    if (fileInput.files[0]) {
        img = await readFile(fileInput.files[0]);
    } else if (type === 'stamp') {
        return alert("スタンプを出品する場合は画像ファイルが必要です");
    }

    const stamp = {
        id: createId(),
        owner: localData.currentUser,
        name: name,
        image: img,
        price: price,
        itemType: type,
        owned: [localData.currentUser]
    };

    if(isOnline) db.ref('stamps/' + stamp.id).set(stamp);
    else state.stamps[stamp.id] = stamp;

    alert("アイテムを出品しました！");
    saveStateLocally();
    openStamps('buy');
    render();
}

function buyStamp(id) {
    const s = state.stamps[id];
    if(!s) return;

    let ownedList = getOwnedArray(s);
    if(ownedList.includes(localData.currentUser)) return;
    if(me().coins < s.price) return alert("コインが足りません");

    me().coins -= s.price;
    ownedList.push(localData.currentUser);
    s.owned = ownedList;

    if(state.users[s.owner]) {
        state.users[s.owner].coins = (state.users[s.owner].coins || 0) + s.price;
        if(isOnline) db.ref('users/' + s.owner).set(state.users[s.owner]);
    }

    if(isOnline) {
        db.ref('users/' + localData.currentUser).set(me());
        db.ref('stamps/' + id).set(s);
    }

    alert("アイテムを購入しました！");
    saveStateLocally();
    openStamps('buy');
    render();
}

