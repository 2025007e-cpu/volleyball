function getMessageContext(msgId) {
    if(viewMode === "group") {
        return { msg: state.group[msgId], path: 'group/' + msgId };
    } else if(currentChat) {
        const key = currentChat.startsWith("keep_") ? currentChat : [localData.currentUser, currentChat].sort().join("_");
        return { msg: state.chats[key]?.[msgId], path: `chats/${key}/${msgId}` };
    }
    return { msg: null, path: '' };
}

function renderMessages() {
    const box = document.getElementById("messages");
    let msgList = [];

    if(viewMode === "group") {
        msgList = Object.values(state.group);
    } else if(currentChat) {
        const key = currentChat.startsWith("keep_") ? currentChat : [localData.currentUser, currentChat].sort().join("_");
        msgList = Object.values(state.chats[key] || {});
    }

    if(msgList.length === 0) {
        box.innerHTML = `<div class="empty">${currentChat && currentChat.startsWith("keep_") ? "自分専用のメモを残せます" : "メッセージはありません"}</div>`;
        return;
    }

    box.innerHTML = msgList.map(msg => {
        const isMine = msg.from === localData.currentUser;
        const sender = state.users[msg.from];
        const senderName = escapeHTML(sender?.name || '不明');

        let contentHtml = '';
        if (msg.unsent) {
            contentHtml = `${senderName}相手には送信取り消しをしました。`;
        } else if (msg.type === 'image') {
            contentHtml = `<img class="message-img" src="${escapeHTML(msg.content)}">`;
        } else if (msg.type === 'stamp') {
            contentHtml = `<img class="stamp-img" src="${escapeHTML(msg.content)}">`;
        } else if (msg.type === 'emoji') {
            contentHtml = `<img class="emoji-img" src="${escapeHTML(msg.content)}">`;
        } else if (msg.type === 'audio') {
            contentHtml = `<audio controls src="${escapeHTML(msg.content)}"></audio>`;
        } else {
            contentHtml = parseEmojiText(msg.content);
        }

        let reactionsHtml = '';
        if (msg.reactions && Object.keys(msg.reactions).length > 0) {
            const pills = Object.entries(msg.reactions).map(([key, uids]) => {
                if(!uids || uids.length === 0) return '';
                const isReacted = uids.includes(localData.currentUser);
                const stampItem = state.stamps?.[key];
                
                let displayContent = escapeHTML(key);
                if (stampItem && stampItem.image) {
                    displayContent = `<img src="${escapeHTML(stampItem.image)}" style="width:16px;height:16px;vertical-align:-3px;object-fit:contain;">`;
                }

                return `<span class="reaction-pill ${isReacted ? 'active':''}" onclick="toggleReaction('${msg.id}', '${escapeHTML(key)}')">${displayContent} ${uids.length}</span>`;
            }).join('');
            reactionsHtml = `<div class="reactions-wrap">${pills}</div>`;
        }

        const pressHandlers = `
            onmousedown="handlePressStart('${msg.id}')" onmouseup="handlePressEnd()" onmouseleave="handlePressEnd()"
            ontouchstart="handlePressStart('${msg.id}')" ontouchend="handlePressEnd()" ontouchmove="handlePressEnd()"
        `;

        return `
            <div class="message-row ${isMine ? 'mine':''}">
                ${!isMine ? `<img class="avatar" src="${escapeHTML(sender?.icon || DEFAULT_AVATAR)}" style="width:32px;height:32px;">`:''}
                <div class="message-container">
                    ${!isMine ? `<div class="sender-name">${senderName}</div>`:''}
                    <div class="message-body-wrap">
                        <div class="message ${msg.unsent ? 'unsent-style' : (msg.type === 'stamp' ? 'stamp-only':'')}" ${!msg.unsent ? pressHandlers : ''}>
                            ${contentHtml}
                        </div>
                        <div class="message-info-wrap" style="align-items: ${isMine ? 'flex-end' : 'flex-start'};">
                            <div class="message-info">${msg.time}</div>
                        </div>
                    </div>
                    ${reactionsHtml}
                </div>
            </div>
        `;
    }).join("");
    box.scrollTop = box.scrollHeight;
}

