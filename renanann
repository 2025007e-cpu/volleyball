<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ChatLeaf Online</title>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
<style>
:root {
    --line-green: #06C755;
    --line-bg: #8cabd9;
    --bubble-mine: #95ec69;
    --bubble-other: #ffffff;
}
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #eef1f4; color: #111; }
button { cursor: pointer; font-family: inherit; }

.app { width: 100%; max-width: 1200px; height: 100vh; margin: 0 auto; background: white; display: flex; overflow: hidden; box-shadow: 0 0 20px rgba(0,0,0,0.1); }
.sidebar { width: 300px; border-right: 1px solid #e0e0e0; background: #f7f7f7; display: flex; flex-direction: column; }
.logo { font-size: 20px; font-weight: bold; padding: 16px; background: #ffffff; border-bottom: 1px solid #eee; color: var(--line-green); display: flex; align-items: center; justify-content: space-between; }
.status-badge { font-size: 10px; padding: 2px 8px; border-radius: 10px; background: #ff4d4f; color: white; }
.status-badge.online { background: #06C755; }
.my-profile { display: flex; align-items: center; gap: 12px; padding: 15px; background: #ffffff; border-bottom: 1px solid #eee; }
.avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; background: #e0e0e0; flex-shrink: 0; }
.coins { font-size: 12px; color: #666; margin-top: 2px; font-weight: bold; }
.tabs { display: flex; padding: 8px; gap: 4px; background: #f0f0f0; }
.tabs button { flex: 1; border: 0; padding: 8px 2px; border-radius: 6px; background: transparent; font-weight: bold; font-size: 11px; color: #666; }
.tabs button.active { background: #ffffff; color: var(--line-green); }
.add-friend-bar { padding: 8px 12px; background: #fff; border-bottom: 1px solid #eee; }
.add-friend-bar button { width: 100%; border: 1px dashed var(--line-green); background: #f0f9f2; color: var(--line-green); font-weight: bold; padding: 6px; border-radius: 6px; font-size: 12px; }
.friend-list { overflow-y: auto; flex: 1; }
.friend { display: flex; align-items: center; gap: 12px; padding: 12px 16px; cursor: pointer; border-bottom: 1px solid #f0f0f0; }
.friend:hover, .friend.active { background: #ebf7ee; }

.main { flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--line-bg); }
.header { height: 60px; background: #ffffff; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid #e0e0e0; }
.header-title { font-size: 17px; font-weight: bold; display: flex; align-items: center; gap: 10px; }
.header-buttons { display: flex; gap: 6px; }
.header button { border: 0; background: #f0f0f0; padding: 6px 12px; border-radius: 16px; font-size: 12px; font-weight: bold; }

.messages { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 12px; }
.empty { height: 100%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; }
.message-row { display: flex; gap: 10px; align-items: flex-start; user-select: none; }
.message-row.mine { flex-direction: row-reverse; }
.message-container { max-width: 65%; display: flex; flex-direction: column; }
.mine .message-container { align-items: flex-end; }
.sender-name { font-size: 11px; color: white; text-shadow: 0 1px 2px rgba(0,0,0,0.3); margin-bottom: 3px; }
.message-body-wrap { display: flex; align-items: flex-end; gap: 6px; }
.mine .message-body-wrap { flex-direction: row-reverse; }
.message { padding: 10px 14px; border-radius: 16px; background: var(--bubble-other); word-break: break-word; font-size: 14px; line-height: 1.4; box-shadow: 0 1px 2px rgba(0,0,0,0.1); cursor: pointer; transition: transform 0.1s; }
.message:active { transform: scale(0.98); }
.mine .message { background: var(--bubble-mine); }
.message.stamp-only { background: transparent; box-shadow: none; padding: 0; }
.message.unsent-style { background: rgba(255, 255, 255, 0.75) !important; color: #666; font-size: 12px; box-shadow: none; border: 1px dashed #ccc; cursor: default; }
.message-img, .stamp-img { max-width: 200px; max-height: 200px; border-radius: 10px; display: block; object-fit: cover; }
.emoji-img { width: 26px; height: 26px; object-fit: contain; vertical-align: -5px; display: inline-block; margin: 0 2px; }
.message audio { max-width: 220px; height: 36px; outline: none; }
.message-info-wrap { display: flex; flex-direction: column; }
.message-info { font-size: 10px; color: white; text-shadow: 0 1px 2px rgba(0,0,0,0.3); }

.reactions-wrap { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
.reaction-pill { background: rgba(255, 255, 255, 0.9); border: 1px solid #ddd; border-radius: 12px; padding: 2px 7px; font-size: 11px; cursor: pointer; display: inline-flex; align-items: center; gap: 3px; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }
.reaction-pill.active { background: #e6f7ff; border-color: #91d5ff; color: #096dd9; font-weight: bold; }

.send-area { background: #ffffff; padding: 10px 16px; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #eee; }
.input-row { display: flex; gap: 6px; align-items: center; }
.send-area input[type="text"] { flex: 1; border: 1px solid #ddd; border-radius: 20px; padding: 8px 14px; font-size: 14px; outline: none; background: #f9f9f9; }
.stamp-btn { border: 0; background: #f0f0f0; border-radius: 50%; width: 36px; height: 36px; font-size: 15px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.2s; }
.stamp-btn.recording { background: #ff4d4f; color: white; animation: pulse 1s infinite; }
.send-button { background: var(--line-green); color: white; border: 0; border-radius: 20px; padding: 0 18px; height: 36px; font-weight: bold; flex-shrink: 0; }

.stamp-picker { display: none; gap: 8px; overflow-x: auto; padding: 6px 0; border-bottom: 1px solid #eee; }
.stamp-picker.active { display: flex; }
.stamp-picker-item { position: relative; display: inline-flex; align-items: center; justify-content: center; min-width: 42px; height: 42px; cursor: pointer; background: #f8f9fa; border-radius: 6px; border: 1px solid #eee; }
.stamp-picker-item img { width: 36px; height: 36px; object-fit: cover; border-radius: 6px; }
.stamp-picker-item .badge { position: absolute; bottom: 0; right: 0; background: rgba(0,0,0,0.6); color: white; font-size: 8px; padding: 1px 3px; border-radius: 3px; line-height: 1; }

.shop-tab-btn { padding: 10px 16px; background: transparent; border: none; font-weight: bold; font-size: 14px; color: #666; cursor: pointer; border-bottom: 3px solid transparent; }
.shop-tab-btn.active { color: var(--line-green); border-bottom-color: var(--line-green); }

.home-view { flex: 1; overflow-y: auto; background: #f4f6f8; padding: 20px; display: flex; flex-direction: column; gap: 16px; }
.home-banner { background: linear-gradient(135deg, #06C755, #029d40); color: white; padding: 20px; border-radius: 14px; }
.home-post { background: white; border-radius: 14px; padding: 18px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); }
.home-post-img { width: 100%; max-height: 300px; object-fit: cover; border-radius: 10px; margin-top: 10px; }

.overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: none; align-items: center; justify-content: center; padding: 20px; z-index: 1000; }
.modal { background: white; width: min(520px, 100%); max-height: 85vh; overflow-y: auto; border-radius: 14px; padding: 20px; }
.modal.large { width: min(850px, 95vw); }
.modal label { font-size: 12px; font-weight: bold; color: #555; display: block; margin-top: 10px; }
.modal input, .modal textarea, .modal select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px; margin: 4px 0 10px; font-family: inherit; }
.modal button { border: 0; border-radius: 6px; padding: 8px 14px; background: #eee; font-weight: bold; margin-top: 6px; }
.green { background: var(--line-green) !important; color: white; }
.red { background: #ff4d4f !important; color: white; }
.user-card { display: flex; align-items: center; justify-content: space-between; background: #f9f9f9; padding: 10px; border-radius: 8px; margin-bottom: 8px; border: 1px solid #eee; }
.survey-card { background: #fff; border: 1px solid #e0e0e0; padding: 12px; border-radius: 8px; margin-bottom: 10px; }

.call-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 15px; margin: 20px 0; }
.call-user-card { display: flex; flex-direction: column; align-items: center; position: relative; }
.call-avatar-wrap { position: relative; width: 64px; height: 64px; border-radius: 50%; }
.call-avatar { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
.call-pulse { position: absolute; inset: -4px; border-radius: 50%; border: 3px solid #06C755; animation: pulse 1.5s infinite; }
@keyframes pulse { 0% { transform: scale(0.95); opacity: 0.8; } 50% { transform: scale(1.1); opacity: 0.3; } 100% { transform: scale(0.95); opacity: 0.8; } }
.mute-icon { position: absolute; bottom: 0; right: 0; background: #ff4d4f; color: white; font-size: 10px; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; }
</style>
</head>
<body>

<div class="app">
    <aside class="sidebar">
        <div class="logo">
            <span>🟢 ChatLeaf</span>
            <span id="netStatus" class="status-badge">オフライン</span>
        </div>
        <div class="my-profile">
            <img id="myIcon" class="avatar" src="">
            <div>
                <b id="myName">読み込み中...</b>
                <div class="coins">🪙 <span id="coinCount">0</span> コイン</div>
            </div>
        </div>
        <div class="tabs">
            <button id="friendTab" class="active" onclick="showFriends()">友だち</button>
            <button id="groupTab" onclick="openGroup()">グループ</button>
            <button id="keepTab" onclick="openKeep()">✍️ キープ</button>
            <button id="homeTab" onclick="openHome()">ホーム</button>
        </div>
        <div class="add-friend-bar">
            <button onclick="openAddFriendModal()">🔑 合言葉で友だち追加</button>
        </div>
        <div id="friendList" class="friend-list"></div>
    </aside>

    <main class="main">
        <div class="header">
            <div id="chatTitle" class="header-title">ChatLeaf</div>
            <div class="header-buttons">
                <button id="groupCallBtn" style="display:none; background:#06C755; color:white;" onclick="joinGroupCall()">📞 通話</button>
                <button onclick="openSurveyModal()">📋 要望</button>
                <button onclick="openProfile()">マイページ</button>
                <button onclick="openStamps('buy')">🛍️ ショップ</button>
                <button onclick="openAdmin()">👑 管理</button>
            </div>
        </div>

        <div id="messages" class="messages"><div class="empty">チャットを選択してください</div></div>
        <div id="homeView" class="home-view" style="display:none;"></div>

        <div id="sendArea" class="send-area">
            <div id="stampPicker" class="stamp-picker"></div>
            <div class="input-row">
                <button class="stamp-btn" onclick="document.getElementById('chatImg').click()" title="画像送信">📷</button>
                <input type="file" id="chatImg" accept="image/*" style="display:none;" onchange="sendImageMessage(this)">
                <button class="stamp-btn" onclick="toggleStampPicker()" title="スタンプ / 絵文字">😊</button>
                <button id="recBtn" class="stamp-btn" onclick="toggleAudioRecording()" title="音声メッセージ録音">🔴</button>
                <button id="sttBtn" class="stamp-btn" onclick="toggleSpeechRecognition()" title="音声文字起こし">🗣️</button>
                <input type="text" id="messageInput" placeholder="メッセージを入力..." onkeydown="if(event.key==='Enter') sendMessage()">
                <button class="send-button" onclick="sendMessage()">送信</button>
            </div>
        </div>
    </main>
</div>

<div id="overlay" class="overlay"><div id="modal" class="modal"></div></div>

<script>
const firebaseConfig = {
    apiKey: "YOUR_API_KEY",
    authDomain: "YOUR_PROJECT.firebaseapp.com",
    databaseURL: "https://YOUR_PROJECT-default-rtdb.firebaseio.com",
    projectId: "YOUR_PROJECT",
    storageBucket: "YOUR_PROJECT.appspot.com",
    messagingSenderId: "xxxx",
    appId: "xxxx"
};

let db = null;
let isOnline = false;

if (firebaseConfig.apiKey !== "YOUR_API_KEY") {
    firebase.initializeApp(firebaseConfig);
    db = firebase.database();
    isOnline = true;
}

const STORAGE_KEY = "chatleaf_pub_v13";
const DEFAULT_AVATAR = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><circle cx='50' cy='50' r='50' fill='%2306C755'/><circle cx='50' cy='40' r='20' fill='%23fff'/><circle cx='50' cy='90' r='35' fill='%23fff'/></svg>";
const RINRIN_ICON = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><circle cx='50' cy='50' r='50' fill='%23ff9a9e'/><circle cx='50' cy='40' r='20' fill='%23fff'/><circle cx='50' cy='90' r='35' fill='%23fff'/></svg>";
const RINRIN_ID = "bot_rinrin";

let localData = JSON.parse(localStorage.getItem(STORAGE_KEY)) || { currentUser: null, cachedState: null };
let state = localData.cachedState || { users: {}, group: {}, chats: {}, stamps: {}, homePosts: {}, admins: {}, calls: {}, surveys: {}, secretCodes: {} };

let currentChat = null;
let viewMode = "chat";
let localAudioStream = null;
let isMuted = false;

let mediaRecorder = null;
let audioChunks = [];
let isRecordingAudio = false;
let recognition = null;
let isRecognizingSpeech = false;

let pressTimer = null;
let isLongPressAction = false;

function saveStateLocally() {
    localData.cachedState = state;
    localStorage.setItem(STORAGE_KEY, JSON.stringify(localData));
}

function createId() { return Date.now().toString() + Math.random().toString(36).slice(2); }
function me() { return state.users[localData.currentUser]; }
function escapeHTML(t) { return String(t||"").replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'})[m]); }

function parseEmojiText(text) {
    let html = escapeHTML(text);
    return html.replace(/\[emoji:([a-zA-Z0-9_\-\.\/:]+)\]/g, (match, stampId) => {
        const item = state.stamps?.[stampId];
        if (item) {
            if(item.image) return `<img class="emoji-img" src="${escapeHTML(item.image)}" title="${escapeHTML(item.name)}">`;
            return escapeHTML(item.name);
        }
        return match;
    });
}

function readFile(file) {
    return new Promise(res => {
        if(!file) return res(null);
        const r = new FileReader();
        r.onload = () => res(r.result);
        r.readAsDataURL(file);
    });
}

function ensureRinrin() {
    if(!state.users[RINRIN_ID]) {
        state.users[RINRIN_ID] = {
            id: RINRIN_ID,
            name: "りんりん 🤖",
            icon: RINRIN_ICON,
            coins: 1000,
            blocked: false,
            isBot: true,
            friends: {}
        };
    }
}

function init() {
    const statusBadge = document.getElementById("netStatus");
    ensureRinrin();

    if (isOnline) {
        statusBadge.textContent = "オンライン同期中";
        statusBadge.classList.add("online");

        db.ref().on('value', snapshot => {
            const data = snapshot.val() || {};
            state.users = data.users || state.users || {};
            state.group = data.group || state.group || {};
            state.chats = data.chats || state.chats || {};
            state.stamps = data.stamps || state.stamps || {};
            state.homePosts = data.homePosts || state.homePosts || {};
            state.admins = data.admins || state.admins || {};
            state.calls = data.calls || {};
            state.surveys = data.surveys || state.surveys || {};
            state.secretCodes = data.secretCodes || state.secretCodes || {};
            ensureRinrin();
            saveStateLocally();
            render();
            
            if(document.getElementById("groupCallModal")) {
                renderCallMembers();
            }
        });
    } else {
        statusBadge.textContent = "オフライン";
        render();
    }

    if (!localData.currentUser || !me()) {
        openAuthModal();
    }
}

function openAuthModal() {
    const userList = Object.values(state.users).filter(u => !u.isBot);
    
    let userOptionsHtml = userList.length > 0 ? `
        <h3>既存アカウントでログイン</h3>
        <div style="display:flex; flex-direction:column; gap:6px; margin-bottom:15px; max-height:180px; overflow-y:auto;">
            ${userList.map(u => `
                <button style="display:flex; align-items:center; gap:10px; text-align:left; background:#f0f7f2; border:1px solid #cce8d5; padding:8px; border-radius:8px;" onclick="selectAccount('${u.id}')">
                    <img src="${escapeHTML(u.icon)}" style="width:32px;height:32px;border-radius:50%;object-fit:cover;">
                    <div>
                        <b>${escapeHTML(u.name)}</b>
                        <div style="font-size:10px; color:#666;">🪙 ${u.coins||0} コイン</div>
                    </div>
                </button>
            `).join('')}
        </div>
        <hr>
    ` : '';

    modal(`
        <h2>ChatLeaf へようこそ</h2>
        ${userOptionsHtml}
        <h3>新規アカウント作成</h3>
        <label>お名前</label><input id="regName" placeholder="名前を入力">
        <label>アイコン (任意)</label><input id="regIcon" type="file" accept="image/*">
        <button class="green" onclick="register()">新規作成してスタート</button>
    `);
}

function selectAccount(uid) {
    localData.currentUser = uid;
    saveStateLocally();
    closeModal();
    render();
}

async function register() {
    const name = document.getElementById("regName").value.trim();
    if(!name) return alert("名前を入力してください");

    const icon = await readFile(document.getElementById("regIcon").files[0]) || DEFAULT_AVATAR;
    const uid = createId();

    const newUser = {
        id: uid,
        name: name,
        icon: icon,
        coins: 100,
        blocked: false,
        friends: { [RINRIN_ID]: true } // AIアシスタントは初期で友だちに追加
    };

    state.users[uid] = newUser;
    localData.currentUser = uid;
    saveStateLocally();

    if(isOnline) db.ref('users/' + uid).set(newUser);
    closeModal();
    render();
}

function logout() {
    localData.currentUser = null;
    saveStateLocally();
    currentChat = null;
    openAuthModal();
}

/* --- 合言葉で友だち追加機能 --- */
function openAddFriendModal() {
    modal(`
        <h2>🔑 合言葉で友だち追加</h2>
        <p style="font-size:12px; color:#666; margin-bottom:12px;">友達と同じ「合言葉」を入力すると、お互いの友だちリストに自動で追加されます。</p>
        <label>合言葉を入力</label>
        <input id="secretCodeInput" placeholder="例：ひみつの部屋123" onkeydown="if(event.key==='Enter') addFriendByCode()">
        <button class="green" style="width:100%; padding:10px; margin-top:10px;" onclick="addFriendByCode()">友だち追加する</button>
        <button style="width:100%; margin-top:6px;" onclick="closeModal()">キャンセル</button>
    `);
}

function addFriendByCode() {
    const codeInput = document.getElementById("secretCodeInput");
    const code = codeInput ? codeInput.value.trim() : "";
    if (!code) return alert("合言葉を入力してください");

    const myUid = localData.currentUser;
    if (!state.secretCodes) state.secretCodes = {};
    if (!state.secretCodes[code]) state.secretCodes[code] = {};

    // 自分のUIDを合言葉に追加
    state.secretCodes[code][myUid] = true;

    // 同じ合言葉に登録されている他のユーザーIDを取得
    const memberUids = Object.keys(state.secretCodes[code]);

    let addedCount = 0;
    memberUids.forEach(uid => {
        if (uid === myUid) return;
        
        // 自分と相手の互いのfriendsリストに追加
        if (!me().friends) me().friends = {};
        if (!state.users[uid]) return;
        if (!state.users[uid].friends) state.users[uid].friends = {};

        if (!me().friends[uid]) {
            me().friends[uid] = true;
            state.users[uid].friends[myUid] = true;
            addedCount++;

            if (isOnline) {
                db.ref(`users/${myUid}/friends/${uid}`).set(true);
                db.ref(`users/${uid}/friends/${myUid}`).set(true);
            }
        }
    });

    if (isOnline) {
        db.ref(`secretCodes/${code}/${myUid}`).set(true);
    }

    saveStateLocally();
    closeModal();
    render();

    if (addedCount > 0) {
        alert(`合言葉「${code}」で ${addedCount} 人の友だちが追加されました！`);
    } else {
        alert(`合言葉「${code}」を登録しました！相手も同じ合言葉を入力すると友だちに追加されます。`);
    }
}

function updateTabButtons(activeTabId) {
    ['friendTab', 'groupTab', 'keepTab', 'homeTab'].forEach(id => {
        const btn = document.getElementById(id);
        if(btn) btn.classList.toggle('active', id === activeTabId);
    });
}

function render() {
    const user = me();
    if(!user) return openAuthModal();

    document.getElementById("myName").textContent = user.name;
    document.getElementById("myIcon").src = user.icon;
    document.getElementById("coinCount").textContent = user.coins;

    const callBtn = document.getElementById("groupCallBtn");
    if(viewMode === "group") callBtn.style.display = "inline-block";
    else callBtn.style.display = "none";

    renderFriends();
    renderStampPicker();

    if(viewMode === "home") renderHome();
    else renderMessages();
}

function renderFriends() {
    const list = document.getElementById("friendList");
    const myFriendsObj = me()?.friends || {};

    // 自分以外で、myFriendsObjに含まれるユーザーのみ表示
    const friends = Object.values(state.users).filter(u => 
        u.id !== localData.currentUser && 
        !u.blocked && 
        (myFriendsObj[u.id] || u.isBot) // りんりんBotまたは友だち登録済みユーザー
    );

    list.innerHTML = friends.map(u => `
        <div class="friend ${currentChat === u.id && viewMode === 'chat' ? 'active':''}" onclick="openChat('${u.id}')">
            <img class="avatar" src="${escapeHTML(u.icon)}">
            <div><b>${escapeHTML(u.name)}</b></div>
        </div>
    `).join("");

    if (friends.length === 0) {
