function toggleReaction(msgId, emojiKey) {
    const { msg, path } = getMessageContext(msgId);
    if(!msg) return;

    if(!msg.reactions) msg.reactions = {};
    if(!msg.reactions[emojiKey]) msg.reactions[emojiKey] = [];

    const uid = localData.currentUser;
    const idx = msg.reactions[emojiKey].indexOf(uid);

    if(idx > -1) {
        msg.reactions[emojiKey].splice(idx, 1);
        if(msg.reactions[emojiKey].length === 0) delete msg.reactions[emojiKey];
    } else {
        msg.reactions[emojiKey].push(uid);
    }

    if(isOnline && path) {
        db.ref(path + '/reactions').set(msg.reactions || null);
    }
    saveStateLocally();
    closeModal();
    renderMessages();
}

function unsendMessage(msgId) {
    if(!confirm("メッセージの送信を取り消しますか？")) return;

    const { msg, path } = getMessageContext(msgId);
    if(msg) {
        msg.unsent = true;
        if(isOnline && path) db.ref(path + '/unsent').set(true);
    }

    saveStateLocally();
    closeModal();
    renderMessages();
}

function pushMessage(content, type="text") {
    const msg = {
        id: createId(), from: localData.currentUser, content: content, type: type,
        time: new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}),
        unsent: false,
        reactions: {}
    };

    if(viewMode === "group") {
        if(isOnline) db.ref('group/' + msg.id).set(msg);
        else state.group[msg.id] = msg;
    } else if(currentChat) {
        const key = currentChat.startsWith("keep_") ? currentChat : [localData.currentUser, currentChat].sort().join("_");
        if(isOnline) db.ref(`chats/${key}/${msg.id}`).set(msg);
        else {
            if(!state.chats[key]) state.chats[key] = {};
            state.chats[key][msg.id] = msg;
        }

        if(currentChat === RINRIN_ID) {
            handleRinrinAI(content, type);
        }
    }

    const user = me();
    if(user) {
        user.coins = (user.coins || 0) + 5;
        if(isOnline) db.ref('users/' + user.id + '/coins').set(user.coins);
        document.getElementById("coinCount").textContent = user.coins;
    }

    saveStateLocally();
    renderMessages();
}

async function handleRinrinAI(userMessage, type) {
    const key = [localData.currentUser, RINRIN_ID].sort().join("_");
    const historyList = Object.values(state.chats[key] || {});

    let replyText = "";

    try {
        const systemPrompt = "あなたの名前は『りんりん』です。LINEで友達と話しているような、明るくフレンドリーで親しみやすい口調（1〜3文章程度）で返答してください。絵文字を効果的に使い、相手の文脈に沿ったかしこく自然な相槌や質問を行ってください。";

        const formattedMessages = [
            { role: "system", content: systemPrompt }
        ];

        historyList.slice(-6).forEach(m => {
            if(!m.unsent) {
                formattedMessages.push({
                    role: m.from === RINRIN_ID ? "assistant" : "user",
                    content: m.type === "text" ? m.content : `(${m.type}を送りました)`
                });
            }
        });

        const response = await fetch("https://text.pollinations.ai/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                messages: formattedMessages,
                model: "openai"
            })
        });

        if (response.ok) {
            replyText = await response.text();
        } else {
            throw new Error("AIエラー");
        }
    } catch (error) {
        console.error("AI Error:", error);
        replyText = "ごめんね、ちょっと電波が悪くて聞き逃しちゃった！もう一度話しかけてくれる？💦";
    }

    const botMsg = {
        id: createId(),
        from: RINRIN_ID,
        content: replyText.trim(),
        type: "text",
        time: new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}),
        unsent: false
    };

    if(isOnline) db.ref(`chats/${key}/${botMsg.id}`).set(botMsg);
    else {
        if(!state.chats[key]) state.chats[key] = {};
        state.chats[key][botMsg.id] = botMsg;
    }
    saveStateLocally();
    renderMessages();
}

