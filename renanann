    modal(`
        <h2>📋 要望・アンケート</h2>
        <p style="font-size:12px; color:#666; margin-bottom:15px;">ChatLeaf へのご意見・新機能のリクエスト・不具合報告などをお送りください。</p>
        <label>種別</label>
        <select id="surveyCategory">
            <option value="💡 機能リクエスト">💡 機能リクエスト</option>
            <option value="🐛 不具合・バグ報告">🐛 不具合・バグ報告</option>
            <option value="💬 その他ご意見">💬 その他ご意見</option>
        </select>
        <label>ご要望・ご意見の内容</label>
        <textarea id="surveyContent" rows="4" placeholder="具体的にご記入ください..."></textarea>
        <button class="green" onclick="submitSurvey()">送信する</button>
        <button onclick="closeModal()">閉じる</button>
    `);
}

function submitSurvey() {
    const category = document.getElementById("surveyCategory").value;
    const content = document.getElementById("surveyContent").value.trim();
    if(!content) return alert("ご要望の内容を入力してください");

    const item = {
        id: createId(),
        userId: localData.currentUser,
        userName: me().name,
        category: category,
        content: content,
        date: new Date().toLocaleString([], {year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit'})
    };

    if(!state.surveys) state.surveys = {};
    state.surveys[item.id] = item;

    if(isOnline) db.ref('surveys/' + item.id).set(item);
    saveStateLocally();

    alert("ご要望をお送りいただきありがとうございました！");
    closeModal();
}

async function joinGroupCall() {
    try {
        localAudioStream = await navigator.mediaDevices.getUserMedia({ audio: true });
    } catch (e) {
        alert("マイクへのアクセスが許可されませんでした。");
        return;
    }

    isMuted = false;
    const callData = {
        id: localData.currentUser,
        name: me().name,
        icon: me().icon,
        muted: false,
        joinedAt: Date.now()
    };

    if(isOnline) db.ref('calls/' + localData.currentUser).set(callData);
    else {
        if(!state.calls) state.calls = {};
        state.calls[localData.currentUser] = callData;
    }

    showCallModal();
}

function showCallModal() {
    modal(`
        <div id="groupCallModal" style="text-align:center;">
            <h2>📞 グループ音声通話</h2>
            <p style="font-size:12px; color:#666;">全員でリアルタイム通話中</p>
            
            <div id="callMembersGrid" class="call-grid"></div>

            <div style="display:flex; justify-content:center; gap:12px; margin-top:20px;">
                <button id="muteBtn" class="green" onclick="toggleMute()">🎙️ マイクON</button>
                <button class="red" onclick="leaveGroupCall()">❌ 通話を終了</button>
            </div>
        </div>
    `);
    renderCallMembers();
}

function renderCallMembers() {
    const grid = document.getElementById("callMembersGrid");
    if(!grid) return;

    const participants = Object.values(state.calls || {});
    grid.innerHTML = participants.map(p => `
        <div class="call-user-card">
            <div class="call-avatar-wrap">
                <img class="call-avatar" src="${escapeHTML(p.icon)}">
                ${!p.muted ? `<div class="call-pulse"></div>`:''}
                ${p.muted ? `<div class="mute-icon">🔇</div>`:''}
            </div>
            <span style="font-size:12px; font-weight:bold; margin-top:6px;">${escapeHTML(p.name)}</span>
        </div>
    `).join("") || `<p style="color:#888;">参加者がいません</p>`;
}

function toggleMute() {
    isMuted = !isMuted;
    if(localAudioStream) {
        localAudioStream.getAudioTracks().forEach(track => track.enabled = !isMuted);
    }
    const btn = document.getElementById("muteBtn");
    btn.textContent = isMuted ? "🔇 ミュート中" : "🎙️ マイクON";
    btn.className = isMuted ? "red" : "green";

    if(state.calls && state.calls[localData.currentUser]) {
        state.calls[localData.currentUser].muted = isMuted;
        if(isOnline) db.ref(`calls/${localData.currentUser}/muted`).set(isMuted);
        renderCallMembers();
    }
}

function leaveGroupCall() {
    if(localAudioStream) {
        localAudioStream.getTracks().forEach(track => track.stop());
        localAudioStream = null;
    }
    if(isOnline) db.ref('calls/' + localData.currentUser).remove();
    else if(state.calls) delete state.calls[localData.currentUser];

    closeModal();
}

function renderHome() {
    const container = document.getElementById("homeView");
    const isAdmin = state.admins[localData.currentUser];
    const posts = Object.values(state.homePosts).reverse();

    let html = `<div class="home-banner"><h1>🌿 ChatLeaf Official Home</h1><p>お知らせ・投稿ボード</p></div>`;
    posts.forEach(p => {
        html += `
            <div class="home-post">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <b>${escapeHTML(p.title)}</b>
                    ${isAdmin ? `<button class="red" onclick="deleteHomePost('${p.id}')">削除</button>`:''}
                </div>
                <div style="font-size:12px; color:#777; margin:4px 0 10px;">${escapeHTML(p.author)} • ${p.date}</div>
                <div>${escapeHTML(p.content)}</div>
                ${p.image ? `<img class="home-post-img" src="${escapeHTML(p.image)}">`:''}
            </div>
        `;
    });
    container.innerHTML = html;
}

function openNewPostModal() {
    modal(`
        <h2>📢 ホームページへ投稿</h2>
        <label>タイトル</label><input id="postTitle">
        <label>本文</label><textarea id="postContent" rows="3"></textarea>
        <label>画像 (任意)</label><input id="postImg" type="file" accept="image/*">
        <button class="green" onclick="submitHomePost()">公開する</button>
        <button onclick="adminPanel()">戻る</button>
    `);
}

async function submitHomePost() {
    const title = document.getElementById("postTitle").value.trim();
    const content = document.getElementById("postContent").value.trim();
    if(!title || !content) return alert("タイトルと本文を入力してください");

    const img = await readFile(document.getElementById("postImg").files[0]);
    const newPost = {
        id: createId(), author: me().name, title: title, content: content, image: img,
        date: new Date().toLocaleDateString()
    };

    if(isOnline) db.ref('homePosts/' + newPost.id).set(newPost);
    else state.homePosts[newPost.id] = newPost;

    saveStateLocally();
    closeModal();
    renderHome();
}

function deleteHomePost(id) {
    if(isOnline) db.ref('homePosts/' + id).remove();
    else delete state.homePosts[id];
    saveStateLocally();
}

function openAdmin() {
    if(state.admins[localData.currentUser]) return adminPanel();
    modal(`
        <h2>👑 管理者認証</h2>
        <label>管理者ユーザー名</label>
        <input id="adminUsername" placeholder="ユーザー名を入力" value="${escapeHTML(me()?.name || '')}">
        <label>管理者コード</label>
        <input id="adminCode" type="password" placeholder="管理者コード">
        <button class="green" onclick="adminLogin()">認証</button>
        <button onclick="closeModal()">閉じる</button>
    `);
}

function adminLogin() {
    const inputName = document.getElementById("adminUsername").value.trim();
    const inputCode = document.getElementById("adminCode").value.trim();

    if(inputName === me()?.name && inputCode === "orerasidai") {
        if(isOnline) db.ref('admins/' + localData.currentUser).set(true);
        else state.admins[localData.currentUser] = true;
        saveStateLocally();
        adminPanel();
    } else { 
        alert("ユーザー名または管理者コードが正しくありません。"); 
    }
}

function adminPanel() {
    const allUsers = Object.values(state.users);
    const surveysList = Object.values(state.surveys || {}).reverse();
    const allStamps = Object.values(state.stamps || {});

    modal(`
        <h2>👑 管理者コントロールパネル</h2>
        
        <div style="background:#fff0f0; padding:12px; border-radius:10px; margin-bottom:15px; border:1px solid #ffccc7;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <h3 style="margin:0; color:#cf1322;">🛍️ ショップアイテム管理 (${allStamps.length}件)</h3>
                <button class="red" style="font-size:11px; padding:4px 8px;" onclick="deleteSelectedStamps()">選択したアイテムを削除</button>
            </div>
            <div style="max-height:180px; overflow-y:auto;">
                ${allStamps.map(s => {
                    const previewHtml = s.image
                        ? `<img src="${escapeHTML(s.image)}" style="width:30px;height:30px;object-fit:cover;border-radius:4px;">`
                        : `<span style="font-size:20px; width:30px; text-align:center;">${escapeHTML(s.name)}</span>`;
                    return `
                        <div style="display:flex; align-items:center; justify-content:space-between; background:white; padding:6px 10px; border-radius:6px; margin-bottom:6px; border:1px solid #ffa39e;">
                            <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                <input type="checkbox" class="stamp-delete-checkbox" value="${s.id}">
                                ${previewHtml}
                                <span style="font-size:12px; font-weight:bold;">${escapeHTML(s.name)}</span>
                                <span style="font-size:10px; background:#eee; padding:1px 5px; border-radius:3px; color:#555;">${s.itemType === 'emoji' ? '絵文字' : 'スタンプ'}</span>
                            </label>
                            <button class="red" style="font-size:10px; padding:2px 6px;" onclick="deleteSingleStamp('${s.id}')">削除</button>
                        </div>
                    `;
                }).join('') || '<div style="font-size:12px; color:#888; text-align:center;">ショップアイテムはありません</div>'}
            </div>
        </div>

        <div style="background:#fff8e7; padding:12px; border-radius:10px; margin-bottom:15px; border:1px solid #ffe58f;">
            <h3 style="margin:0 0 8px 0; color:#d48806;">📋 届いた要望・アンケート (${surveysList.length}件)</h3>
            <div style="max-height:180px; overflow-y:auto;">
                ${surveysList.map(s => `
                    <div class="survey-card">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                            <span style="font-size:11px; font-weight:bold; background:#e6f7ff; color:#1890ff; padding:2px 6px; border-radius:4px;">${escapeHTML(s.category)}</span>
                            <button class="red" style="font-size:10px; padding:2px 6px;" onclick="deleteSurvey('${s.id}')">削除</button>
                        </div>
                        <div style="font-size:13px; font-weight:bold; color:#333; white-space:pre-wrap;">${escapeHTML(s.content)}</div>
                        <div style="font-size:10px; color:#888; text-align:right; margin-top:6px;">送信者: ${escapeHTML(s.userName)} (${s.date})</div>
                    </div>
                `).join('') || '<div style="font-size:12px; color:#888; text-align:center;">届いた要望はありません</div>'}
            </div>
        </div>

        <div style="background:#eef7ee; padding:12px; border-radius:10px; margin-bottom:15px;">
            <h3 style="margin:0 0 8px 0;">📝 ホーム投稿</h3>
            <button class="green" onclick="openNewPostModal()">＋ お知らせを投稿する</button>
        </div>

        <h3>👥 ユーザーの手持ち管理</h3>
        <div style="max-height:180px; overflow-y:auto; margin-bottom:15px;">
            ${allUsers.map(u => `
                <div class="user-card">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <img src="${escapeHTML(u.icon)}" style="width:36px;height:36px;border-radius:50%;object-fit:cover;">
                        <div>
                            <b>${escapeHTML(u.name)}</b>
                            <div style="font-size:11px; color:#666;">🪙 ${u.coins||0} コイン</div>
                        </div>
                    </div>
                    <div style="display:flex; gap:6px;">
                        <button class="green" style="font-size:11px;" onclick="adminEditUserCoins('${u.id}')">コイン変更</button>
                        <button style="font-size:11px;" onclick="adminManageUserStamps('${u.id}')">スタンプ変更</button>
                    </div>
                </div>
            `).join('')}
        </div>

        <button onclick="closeModal()">閉じる</button>
    `, true);
}

function deleteSingleStamp(stampId) {
    if(!confirm("このショップアイテムを削除しますか？")) return;
    deleteStampById(stampId);
    saveStateLocally();
    adminPanel();
    render();
}

function deleteSelectedStamps() {
    const checkedBoxes = document.querySelectorAll('.stamp-delete-checkbox:checked');
    const selectedIds = Array.from(checkedBoxes).map(cb => cb.value);

    if (selectedIds.length === 0) {
        alert("削除するアイテムを選択してください。");
        return;
    }

    if (!confirm(`選択した ${selectedIds.length} 件のアイテムを削除してもよろしいですか？`)) {
        return;
    }

    selectedIds.forEach(id => deleteStampById(id));
    saveStateLocally();
    alert("選択したアイテムを削除しました。");
    adminPanel();
    render();
}

function deleteStampById(stampId) {
    delete state.stamps[stampId];
    if(isOnline) {
        db.ref('stamps/' + stampId).remove();
    }
}

function deleteSurvey(id) {
    if(confirm("この要望を削除しますか？")) {
        if(isOnline) db.ref('surveys/' + id).remove();
        else if(state.surveys) delete state.surveys[id];
        saveStateLocally();
        adminPanel();
    }
}

function adminEditUserCoins(uid) {
    const targetUser = state.users[uid];
    if(!targetUser) return;

    const newCoins = prompt(`${targetUser.name} のコイン数を設定してください:`, targetUser.coins || 0);
    if(newCoins === null || isNaN(newCoins)) return;

    targetUser.coins = Number(newCoins);
    if(isOnline) db.ref('users/' + uid).set(targetUser);
    saveStateLocally();
    alert(`${targetUser.name} のコインを ${targetUser.coins} に変更しました！`);
    adminPanel();
    render();
}

function adminManageUserStamps(uid) {
    const targetUser = state.users[uid];
    if(!targetUser) return;
    const stamps = Object.values(state.stamps);

    modal(`
        <h2>🎨 ${escapeHTML(targetUser.name)} のスタンプ所有状態</h2>
        <div style="display:flex; flex-direction:column; gap:8px; margin:15px 0; max-height:300px; overflow-y:auto;">
            ${stamps.map(s => {
                let ownedList = getOwnedArray(s);
                const has = ownedList.includes(uid);
                const previewHtml = s.image
                    ? `<img src="${escapeHTML(s.image)}" style="width:40px;height:40px;object-fit:cover;">`
                    : `<span style="font-size:24px; width:40px; text-align:center;">${escapeHTML(s.name)}</span>`;
                return `
                    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #eee; padding:6px 0;">
                        <div style="display:flex; align-items:center; gap:8px;">
                            ${previewHtml}
                            <b>${escapeHTML(s.name)}</b>
                        </div>
                        <button class="${has ? 'red':'green'}" style="font-size:11px;" onclick="adminToggleStamp('${uid}', '${s.id}')">
                            ${has ? '没収する' : '付与する'}
                        </button>
                    </div>
                `;
            }).join('') || '<div>スタンプが存在しません</div>'}
        </div>
        <button onclick="adminPanel()">戻る</button>
    `);
}

function adminToggleStamp(uid, stampId) {
    const stamp = state.stamps[stampId];
    if(!stamp) return;

    let ownedList = getOwnedArray(stamp);
    if(ownedList.includes(uid)) {
        ownedList = ownedList.filter(id => id !== uid);
    } else {
        ownedList.push(uid);
    }
    stamp.owned = ownedList;

    if(isOnline) db.ref('stamps/' + stampId).set(stamp);
    saveStateLocally();
    adminManageUserStamps(uid);
    render();
}

function openProfile() {
    modal(`
        <h2>マイページ</h2>
        <label>名前</label><input id="pName" value="${escapeHTML(me().name)}">
        <button class="green" onclick="saveProfile()">保存</button>
        <hr style="margin:15px 0;">
        <button class="red" style="width:100%;" onclick="logout()">ログアウト / アカウント切り替え</button>
        <button onclick="closeModal()">閉じる</button>
    `);
}

function saveProfile() {
    me().name = document.getElementById("pName").value.trim();
    if(isOnline) db.ref('users/' + localData.currentUser).set(me());
    saveStateLocally();
    closeModal();
    render();
}

function modal(html, isLarge=false) {
    const m = document.getElementById("modal");
    m.className = isLarge ? "modal large":"modal";
    m.innerHTML = html;
    document.getElementById("overlay").style.display = "flex";
}
function closeModal() { document.getElementById("overlay").style.display = "none"; }

init();
</script>
</body>
</html>
